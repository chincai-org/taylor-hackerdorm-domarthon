# Local development and Vercel production both use Neon Postgres.
# Put the local pooled connection string in .env.development.local.
# DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require

# Model API credentials (OpenAI-compatible). The deployed harness targets the
# GraffiLab PI endpoint, so GRAFFILAB_API_KEY is the expected credential.
# DEEPSEEK_API_KEY wins when both are set (local override path).
# GRAFFILAB_API_KEY=

# Model + endpoint. Defaults already point at Grafilab when no DeepSeek key set:
# GRAFFILAB_BASE_URL=https://llm.grafilab.ai/v1
# GRAFFILAB_MODEL=grafilab/deepseek-v4-flash

# DeepSeek override path (optional).
# DEEPSEEK_API_KEY=

# Model DeepSeek runs with.
# DEEPSEEK_MODEL=deepseek-chat

# Candidate rollout for evaluation: harness output is produced via
# POST {CANDIDATE_BASE_URL}/api/v1/deepseek/chat, then scored by Grafilab.
# CANDIDATE_BASE_URL=https://taylor-hackerdorm-domarthon-production.up.railway.app
# CANDIDATE_MAX_STEPS=5

# Optional override of the DeepSeek OpenAI-compatible endpoint.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Boot literal dsh web UI on a node harness (local server only, never hosted).
# ALLOW_DSH_SPAWN=1

# Frontend-only configuration, when a separate frontend is added.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:5001/api/v1
