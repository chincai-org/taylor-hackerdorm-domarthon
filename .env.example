# Local development and Vercel production both use Neon Postgres.
# Put the local pooled connection string in .env.development.local.
# DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require

# DeepSeek (OpenAI-compatible) credentials for the customer-support harness.
# DEEPSEEK_API_KEY=

# Model DeepSeek runs with.
# DEEPSEEK_MODEL=deepseek-chat

# Optional override of the DeepSeek OpenAI-compatible endpoint.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Frontend-only configuration, when a separate frontend is added.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:5001/api/v1
