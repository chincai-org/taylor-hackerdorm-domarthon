# Local development uses SQLite when DATABASE_URL is empty or unset.
LOCAL_DATABASE_PATH=data/local.db

# Vercel/Neon: replace this with the pooled connection string.
# DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require

# Pi agent / GrafiLab credentials. The canonical name is GRAPHILIB_API_KEY;
# GRAFILAB_API_KEY and GRAFFILAB_API_KEY are also accepted (Docker start.sh
# checks all three). Set ONE of them on Railway or Pi chat returns nothing.
# GRAPHILIB_API_KEY=

# Model Pi runs with (must match a "models" entry for the grafilab provider).
# PI_MODEL=qwen/qwen3.7-flash

# Optional override of the GrafiLab OpenAI-compatible endpoint.
# GRAFILAB_BASE_URL=https://llm.grafilab.ai/v1

# Frontend-only configuration, when a separate frontend is added.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:5001/api/v1
