# Petri environment.
# Copy this file to .env. Every variable is OPTIONAL.
# With none of them set, every command runs in replay mode on the local log.

# The Anthropic API key. It lets the harness call a real model.
# WITHOUT IT: use `--mode replay`. The sandbox and the tests still run for real,
# but the harness replays recorded answers. A replay number is never compared
# with a live number.
# WITH IT: `--mode live` calls Claude Sonnet 5.
ANTHROPIC_API_KEY=

# The Hedera account that pays for topic messages, as "0.0.12345".
# WITH IT and HEDERA_OPERATOR_KEY: `petri anchor create` makes a public topic, and
# every command that writes a record then sends it to that topic.
# WITHOUT IT: the records stay in .petri/log.jsonl on this machine only.
HEDERA_OPERATOR_ID=

# The private key for HEDERA_OPERATOR_ID. DER, ED25519 or ECDSA encoding.
# Petri reads it only from this variable. It never writes it to a file.
HEDERA_OPERATOR_KEY=

# The network `petri init` writes into a new config: testnet, mainnet or previewnet.
# `petri anchor create` takes `--network` instead. Both default to testnet.
HEDERA_NETWORK=testnet

# The World ID check after `petri verify`. It is OFF unless this is 1.
# It looks up the wallet below in World AgentBook on World Chain, and records the
# anonymous human id in .petri/world-checks.jsonl. It does not change acceptance.
PETRI_WORLD_ID=0

# The verifier's wallet registered in AgentBook, as 0x followed by 40 hex characters.
PETRI_WORLD_ADDRESS=
