{
  "name": "petri",
  "version": "0.1.0",
  "private": true,
  "description": "A git for AI agent harness evolution. Every commit carries an independently verified measurement, and nothing is ever deleted.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "petri": "./src/cli/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "petri": "tsx src/cli/index.ts",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@hashgraph/sdk": "^2.81.0",
    "commander": "^15.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0"
  }
}
